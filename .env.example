# Public client configuration. Do not put credentials or server secrets here.
# iOS Simulator/web: localhost. Android emulator: 10.0.2.2.
# Physical phone: use your Mac LAN address in all three base URLs below.
# Django must listen on the LAN and allow that host for physical devices.
# Metro inlines these values. Fully reload the app after changing them.

# Base urls
EXPO_PUBLIC_API_URL=http://localhost:8000
EXPO_PUBLIC_ROOT_API_URL=http://localhost:8000/api
EXPO_PUBLIC_ROOT_WS_URL=ws://localhost:8000/ws
EXPO_PUBLIC_WS_MAINTENANCE_ROOT=/ws/maintenance/

# Account
EXPO_PUBLIC_ACCOUNT_REFRESH_TOKEN=/account/token_refresh/
EXPO_PUBLIC_ACCOUNT_LOGIN=/account/login/
EXPO_PUBLIC_ACCOUNT_LOGOUT=/account/logout/
EXPO_PUBLIC_ACCOUNT_CHECK_EMAIL=/account/check_email/
EXPO_PUBLIC_ACCOUNT_PASSWORD_CHANGE=/account/password_change/
EXPO_PUBLIC_ACCOUNT_SEND_PASSWORD_RESET=/account/send_password_reset/
EXPO_PUBLIC_ACCOUNT_PASSWORD_RESET=/account/password_reset/
EXPO_PUBLIC_ACCOUNT_PROFIL=/account/profil/
EXPO_PUBLIC_ACCOUNT_GROUPS=/account/group/
EXPO_PUBLIC_USERS_ROOT=/account/users/

# Company
EXPO_PUBLIC_COMPANY_ROOT=/company
EXPO_PUBLIC_COMPANY_LIST=/company/
EXPO_PUBLIC_USER_COMPANIES_LIST=/company/by_user/

# Clients
EXPO_PUBLIC_CLIENT_ROOT=/client
EXPO_PUBLIC_CLIENT_LIST=/client/
EXPO_PUBLIC_ARCHIVE_CLIENT=/client/archive/

# Parameters
EXPO_PUBLIC_PARAMETER_VILLE=/parameter/ville/

# Notifications
EXPO_PUBLIC_FACTURATION_NOTIFICATIONS=/notifications/
EXPO_PUBLIC_FACTURATION_NOTIFICATION_PREFERENCES=/notifications/preferences/
EXPO_PUBLIC_FACTURATION_NOTIFICATION_MARK_READ=/notifications/mark-read/
EXPO_PUBLIC_FACTURATION_NOTIFICATION_UNREAD_COUNT=/notifications/unread-count/
