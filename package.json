{
	"$schema": "https://json.schemastore.org/package.json",
	"name": "facturation_native",
	"version": "3.8.4",
	"main": "expo-router/entry",
	"scripts": {
		"dev": "expo start",
		"start": "expo start",
		"ios": "expo run:ios",
		"android": "expo run:android",
		"android:production": "expo run:android --variant release",
		"web": "expo start --web",
		"debug": "expo start --clear",
		"build": "expo export --platform all",
		"build:ios": "expo export --platform ios",
		"build:android": "expo export --platform android",
		"build:android:production": "expo prebuild --platform android && ./android/gradlew -p android app:assembleRelease",
		"analyse": "EXPO_ATLAS=true expo start --no-dev",
		"lint": "eslint .",
		"typecheck": "node node_modules/@typescript/native/bin/tsc --noEmit",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"upgrade": "expo install --fix --bun",
		"upgrade:check": "expo install --check --bun",
		"outdated": "ncu --packageManager bun",
		"doctor": "expo-doctor",
		"test": "node scripts/jest.ts --runInBand --passWithNoTests",
		"test:watch": "node scripts/jest.ts --watch",
		"test:coverage": "node scripts/jest.ts --maxWorkers=50% --coverage --coverageProvider=v8 --passWithNoTests",
		"check": "bun run typecheck && bun run lint && bun run test"
	},
	"dependencies": {
		"@babel/runtime": "^7.29.10",
		"@expo/metro-runtime": "~58.0.14",
		"@expo/ui": "~58.0.21",
		"@expo/vector-icons": "^15.1.1",
		"@react-native-async-storage/async-storage": "2.2.0",
		"@react-native-community/datetimepicker": "9.2.1",
		"@reduxjs/toolkit": "^2.13.0",
		"@shopify/flash-list": "2.3.2",
		"axios": "^1.20.0",
		"axios-auth-refresh": "^5.0.2",
		"date-fns": "^4.4.0",
		"expo": "~58.0.16",
		"expo-asset": "~58.0.17",
		"expo-constants": "~58.0.12",
		"expo-dev-client": "~58.0.14",
		"expo-file-system": "~58.0.10",
		"expo-flash-datagrid": "0.2.1",
		"expo-font": "~58.0.9",
		"expo-image": "~58.0.16",
		"expo-image-manipulator": "~58.0.15",
		"expo-image-picker": "~58.0.10",
		"expo-linking": "~58.0.13",
		"expo-notifications": "~58.1.5",
		"expo-router": "~58.0.24",
		"expo-secure-store": "~58.0.2",
		"expo-splash-screen": "~58.0.10",
		"expo-status-bar": "~58.0.3",
		"formik": "^2.4.9",
		"react": "19.3.0",
		"react-dom": "19.3.0",
		"react-native": "0.88.0",
		"react-native-autocomplete-dropdown": "^5.1.0",
		"react-native-gesture-handler": "~3.3.0",
		"react-native-keyboard-controller": "1.22.7",
		"react-native-reanimated": "4.7.1",
		"react-native-safe-area-context": "~5.10.1",
		"react-native-screens": "~4.30.0",
		"react-native-svg": "15.16.0",
		"react-native-web": "~0.21.4",
		"react-native-worklets": "0.13.0",
		"react-native-zoom-toolkit": "5.1.1",
		"react-redux": "^9.3.0",
		"redux-saga": "^1.5.1",
		"tailwindcss": "^4.3.3",
		"uniwind": "^1.12.2",
		"zod": "^4.6.7",
		"zod-formik-adapter": "^2.0.0"
	},
	"devDependencies": {
		"@babel/core": "^7.29.7",
		"@eslint/compat": "^2.1.1",
		"@react-native/jest-preset": "0.88.0",
		"@react-native/metro-config": "0.88.0",
		"@testing-library/react-native": "^14.1.0",
		"@types/babel__core": "^7.20.5",
		"@types/jest": "^30.0.0",
		"@types/node": "^26.6.5",
		"@types/react": "~19.3.0",
		"@typescript/native": "npm:typescript@7.0.2",
		"eslint": "10.13.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-expo": "^1.2.1",
		"eslint-plugin-import-x": "^4.17.1",
		"eslint-plugin-react": "^7.37.5",
		"eslint-plugin-react-hooks": "^7.1.1",
		"expo-atlas": "^0.5.0",
		"expo-doctor": "^1.21.5",
		"globals": "^17.13.0",
		"jest": "^30.5.2",
		"jest-expo": "~58.0.11",
		"jiti": "^2.7.0",
		"metro": "^0.87.1",
		"metro-cache": "^0.87.1",
		"npm-check-updates": "^23.1.1",
		"prettier": "^3.9.10",
		"test-renderer": "~1.3.1",
		"typescript": "npm:@typescript/typescript6@^6.0.2",
		"typescript-eslint": "^8.71.2"
	},
	"trustedDependencies": [
		"unrs-resolver"
	],
	"private": true,
	"packageManager": "bun@1.4.3",
	"engines": {
		"node": "^22.18.0 || ^24.3.0 || >=26.0.0",
		"bun": ">=1.4.3"
	},
	"expo": {
		"install": {
			"exclude": [
				"typescript",
				"jest",
				"@types/jest",
				"metro"
			]
		}
	}
}
