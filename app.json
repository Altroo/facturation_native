{
	"expo": {
		"name": "E.B.H Facturation",
		"slug": "facturation-native",
		"scheme": "facturation-native",
		"version": "3.8.27",
		"orientation": "portrait",
		"userInterfaceStyle": "automatic",
		"icon": "./assets/icon.png",
		"ios": {
			"supportsTablet": true,
			"bundleIdentifier": "ma.facturation.mobile",
			"infoPlist": {
				"CFBundleLocalizations": ["fr", "en"],
				"NSAppTransportSecurity": {
					"NSAllowsLocalNetworking": true
				}
			}
		},
		"android": {
			"package": "ma.facturation.mobile",
			"adaptiveIcon": {
				"foregroundImage": "./assets/android-icon-foreground.png",
				"backgroundColor": "#ffffff"
			}
		},
		"web": {
			"bundler": "metro",
			"output": "static",
			"favicon": "./assets/favicon.png"
		},
		"plugins": [
			["expo-router", { "apiRoutes": true }],
			"expo-font",
			"expo-secure-store",
			[
				"expo-image-picker",
				{
					"photosPermission": "Choisir une photo de profil, un logo ou un cachet.",
					"cameraPermission": "Prendre une photo de profil, un logo ou un cachet.",
					"microphonePermission": false
				}
			],
			[
				"@react-native-community/datetimepicker",
				{
					"android": {
						"datePicker": {
							"colorAccent": {
								"light": "#0274d7",
								"dark": "#0274d7"
							}
						}
					}
				}
			],
			"expo-image",
			"expo-asset",
			[
				"expo-splash-screen",
				{
					"image": "./assets/facturation-logo.png",
					"imageWidth": 120,
					"resizeMode": "contain",
					"backgroundColor": "#ffffff",
					"dark": {
						"backgroundColor": "#121722"
					}
				}
			],
			"expo-status-bar"
		],
		"experiments": {
			"typedRoutes": true,
			"reactCompiler": true
		}
	}
}
